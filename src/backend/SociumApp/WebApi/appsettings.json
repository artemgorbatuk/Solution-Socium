{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "Jwt": {
      "Issuer": "Socium",
      "Audience": "Socium",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14
    },
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Messaging": {
    "Confirmation": {
      "BaseUrl": "http://127.0.0.1:4200/confirm-email",
      "TokenDays": 2,
      "Channel": "Email"
    },
    "PasswordReset": {
      "BaseUrl": "http://127.0.0.1:4200/reset-password",
      "TokenDays": 1,
      "Channel": "Email"
    },
    "Smtp": {
      "Host": "127.0.0.1",
      "Port": 1025,
      "EnableSsl": false,
      "From": "noreply@localhost",
      "FromDisplayName": "Socium",
      "TimeoutSeconds": 10
    },
    "RateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  }
}
